{
    "layer": "top",
    "position": "bottom",
    "height": 48, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width, default is full width
    "spacing": 5, // Gaps between modules


    // TODO apps/spotify
    "modules-left": ["wlr/taskbar"],
    "modules-center": ["hyprland/workspaces"],
    // TODO merge battery and backlight
    "modules-right": ["network", "backlight", "hyprland/language", "pulseaudio", "battery", "clock"],

    "wlr/taskbar": {
        "icon-size": 24,
	"icon-theme": "Papirus",
	"all-outputs": false,
	"on-click": "minimize-raise",
	"on-click-middle": "close",
	"on-click-right": "minimize"
    },
    // Modules configuration
    // FIXME https://github.com/Alexays/Waybar/wiki/Module:-Workspaces
    "hyprland/workspaces": {
        "active-only": false,
        "all-outputs": true,
        "format": "{name}",
        "show-special": false,
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },

    "hyprland/language": {
        "format": "{shortDescription}",
        "tooltip-format": "{long}"
        // TODO change language
        // "onclick":
    },

    "hyprland/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "hyprland/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    "tray": {
        "icon-size": 24,
        "spacing": 10
    },

    "clock": {
        // "timezone": "America/Mexico_City",
        // I had this with <b> but since version 10.0 it is broken
        "format": "{:%H:%M\n%d %b}"
    },

    "backlight": {
        "format": "{icon}{percent}%",
        "format-icons": ["󰛩 ", "󱩎 ", "󱩏 ", "󱩐 ", "󱩑 ", "󱩒 ", "󱩓 ", "󱩔 ", "󱩕 ", "󱩖 ", "󰛨 "]
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} ",
        "format-alt": "{capacity}% {time}",
        "format-icons": ["", "", "", "", ""]
    },

    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀 ",
        "tooltip-format": "{essid}:{ipaddr}",
        "format-linked": "{ifname}",
        "format-disconnected": "󰤮 ",
        "format-alt": "{icon}: {essid}",
        "format-icons": ["󰤯 ", "󰤟 ", "󰤢 ", "󰤥 ", "󰤨 "]
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-icons": {
            //"default": [" ", " ", " "]
            "default": ["\uf027 ", "\uf028 "]
        },
        "format-muted": "\ueee8 ",
        "scroll-step": 1,
        "on-click-right": "pavucontrol",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "ignored-sinks": ["Easy Effects Sink"]
    }
}

